<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DiskSentinel.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DiskSentinel.Controls"
    Title="磁盘哨兵">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0" Padding="20,14,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="磁盘哨兵" FontSize="21" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="正在读取磁盘健康数据…" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="RefreshBtn" Click="OnRefreshClick" ToolTipService.ToolTip="重新检测">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="重新检测" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主体 -->
        <Grid Grid.Row="1" Padding="20,0,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：磁盘列表 -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="磁盘" FontSize="12" FontWeight="SemiBold"
                               Margin="14,12,14,6"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <ListView x:Name="DiskList" Grid.Row="1"
                              SelectionMode="Single"
                              SelectionChanged="OnDiskSelected"
                              Padding="4,0,4,8">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,9" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 健康度圆环 -->
                                    <Grid Grid.Column="0" Width="42" Height="42" VerticalAlignment="Center">
                                        <Ellipse Width="42" Height="42"
                                                 Stroke="{ThemeResource ControlStrokeColorDefaultBrush}"
                                                 StrokeThickness="3" />
                                        <Ellipse Width="42" Height="42"
                                                 Stroke="{Binding LevelColor}"
                                                 StrokeThickness="3"
                                                 StrokeDashArray="{Binding DashArray}"
                                                 StrokeDashOffset="0"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-90" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <TextBlock Text="{Binding HealthText}" FontSize="11"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Model}" FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxLines="1" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding LevelText}" FontSize="11"
                                                       Foreground="{Binding LevelColor}" />
                                            <TextBlock Text="·" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding TempText}" FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding BusLine}" FontSize="10"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 右：详情 + 图表 -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DetailPanel" Spacing="12">

                    <!-- 标题卡 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="5">
                                <TextBlock x:Name="DetailModel" FontSize="17" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DetailSub" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" x:Name="LevelBadge"
                                    CornerRadius="14" Padding="14,6" VerticalAlignment="Center">
                                <TextBlock x:Name="LevelBadgeText" FontSize="13" FontWeight="SemiBold"
                                           Foreground="White" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 关键指标 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18,14">
                        <StackPanel Spacing="9">
                            <TextBlock Text="关键指标" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ItemsControl x:Name="DetailRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                                       Foreground="{Binding Color}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 历史趋势 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18,14">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="历史趋势" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="TrendSelector" Grid.Column="1" MinWidth="140"
                                          SelectionChanged="OnTrendChanged" FontSize="12">
                                    <ComboBoxItem Content="健康度 (%)" Tag="health" />
                                    <ComboBoxItem Content="累计写入 (TB)" Tag="written" />
                                    <ComboBoxItem Content="温度 (°C)" Tag="temp" />
                                    <ComboBoxItem Content="通电时间 (h)" Tag="hours" />
                                </ComboBox>
                            </Grid>

                            <controls:ChartCanvas x:Name="TrendChart" Height="170" />

                            <TextBlock x:Name="TrendEmptyHint" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       Text="还没有足够的历史记录。每次开机检测会记一笔，攒几次就能看到趋势了。" />
                        </StackPanel>
                    </Border>

                    <!-- 磁盘对比 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18,14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="各磁盘对比" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <controls:ChartCanvas x:Name="CompareChart" Height="120" Margin="0,0,60,0" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底栏 -->
        <Grid Grid.Row="2" Padding="20,6,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterText" Grid.Column="0" FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="AutoStartBtn" Click="OnAutoStartClick" FontSize="12"
                        Content="注册开机检测" />
                <Button x:Name="OpenDataBtn" Click="OnOpenDataClick" FontSize="12"
                        Content="打开数据目录" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
